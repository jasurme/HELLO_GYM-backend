{
  "name": "binaryfit-gym",
  "version": "1.0.0",
  "description": "Gym Membership and Training Booking System (Binary Minds, Database Design project)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:reset": "node scripts/db-reset.js",
    "db:seed": "node scripts/generate-seed.js",
    "test": "NODE_ENV=test jest --runInBand",
    "db:check-rules": "node scripts/check-rules.js"
  },
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "^4.6.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "mysql2": "$mysql2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/global-setup.js",
    "testTimeout": 30000
  }
}
