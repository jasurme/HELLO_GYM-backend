# Copy to .env (scripts/setup-mysql.sh and the app both read it)
PORT=3000
SESSION_SECRET=change-me
TZ=Asia/Seoul

# MySQL: dedicated app user created by scripts/setup-mysql.sh
DB_NAME=gym_db
DB_TEST_NAME=gym_test
DB_USER=gym_app
DB_PASSWORD=change-me
DB_SOCKET=/tmp/mysql.sock
DB_HOST=127.0.0.1
DB_PORT=3306
MYSQL_BIN=/usr/local/mysql/bin/mysql
